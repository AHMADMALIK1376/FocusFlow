# Copy to .env for local work. On Render, add the same names as environment variables.
# Never commit the real .env.

NODE_ENV=development            # "production" on Render (this also locks CORS)
PORT=5555                       # Render sets its own PORT; leave it out there

JWT_SECRET=                     # a long random string, 32+ characters

# PostgreSQL (Supabase > Project Settings > Database)
PGHOST=
PGPORT=5432
PGDATABASE=postgres
PGUSER=
PGPASSWORD=

# Email. EMAIL_PROVIDER is smtp (Gmail App Password) or gmail_api (OAuth over HTTPS).
# Render's free plan blocks SMTP ports, so use gmail_api there.
EMAIL_PROVIDER=smtp          # gmail_api on Render
EMAIL_USER=                  # the sender Gmail address, for both providers
EMAIL_PASS=                  # smtp only: Gmail App Password
GMAIL_CLIENT_ID=             # gmail_api only
GMAIL_CLIENT_SECRET=         # gmail_api only
GMAIL_REFRESH_TOKEN=         # gmail_api only (minted for the EMAIL_USER account, scope gmail.send)

# Where things live (no trailing slash)
APP_URL=http://localhost:3001            # the Vercel address in production
PUBLIC_API_URL=http://localhost:5555     # the Render address in production
ALLOWED_ORIGINS=                         # extra websites allowed to call the API, comma separated (production only)

# Phone pop-ups (web push): npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Outside reminder trigger and operator endpoints: a long random string (for example `openssl rand -hex 32`).
# The pinger sends it (see README, "Keep the reminders running"). Unset = those endpoints answer 503 (closed).
CRON_SECRET=

DEFAULT_TZ=Asia/Karachi
