# Copy to .env for local work. On Render, add the same names as environment variables.
# Never commit the real .env.

NODE_ENV=development            # "production" on Render (this also locks CORS)
PORT=5555                       # Render sets its own PORT; leave it out there

JWT_SECRET=                     # a long random string, 32+ characters

# PostgreSQL (Supabase > Project Settings > Database)
PGHOST=
PGPORT=5432
PGDATABASE=postgres
PGUSER=
PGPASSWORD=

# Email (Gmail + App Password)
EMAIL_USER=
EMAIL_PASS=

# Where things live (no trailing slash)
APP_URL=http://localhost:3001            # the Vercel address in production
PUBLIC_API_URL=http://localhost:5555     # the Render address in production
ALLOWED_ORIGINS=                         # extra websites allowed to call the API, comma separated (production only)

# Phone pop-ups (web push): npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

DEFAULT_TZ=Asia/Karachi
