# Copy to .env for local work. On Render, add the same names as environment variables.
# Never commit the real .env.

NODE_ENV=development            # "production" on Render (this also locks CORS)
PORT=5555                       # Render sets its own PORT; leave it out there

JWT_SECRET=                     # a long random string, 32+ characters

# PostgreSQL (Supabase > Project Settings > Database)
PGHOST=
PGPORT=5432
PGDATABASE=postgres
PGUSER=
PGPASSWORD=

# Email. How mail leaves the server (EMAIL_PROVIDER): smtp (default, your own computer only), gmail-api, or apps-script.
# Render's FREE plan blocks SMTP, so production must use gmail-api or apps-script.
# Click-by-click setup: docs/email-relay/README.md
EMAIL_PROVIDER=smtp
EMAIL_USER=                     # your Gmail address (the sender)
EMAIL_PASS=                     # Gmail App Password (smtp only)
GMAIL_CLIENT_ID=                # gmail-api only
GMAIL_CLIENT_SECRET=            # gmail-api only
GMAIL_REFRESH_TOKEN=            # gmail-api only
APPS_SCRIPT_URL=                # apps-script only: the Web app URL ending in /exec
APPS_SCRIPT_SECRET=             # apps-script only: the same value as SECRET in the script

# Private trigger for the reminder job, and for the server's diagnostics. A free monitor (UptimeRobot)
# visits  https://YOUR-RENDER-ADDRESS/api/cron/tick?key=<this value>  every 5 minutes, which wakes the
# free server and sends due reminders. Leave empty to switch the trigger and the diagnostics off.
CRON_SECRET=

# Local development only: stop this copy from also sending reminders while the real server is running.
REMINDER_SCHEDULER=on           # "off" to disable

# Where things live (no trailing slash)
APP_URL=http://localhost:3001            # the Vercel address in production
PUBLIC_API_URL=http://localhost:5555     # the Render address in production
ALLOWED_ORIGINS=                         # extra websites allowed to call the API, comma separated (production only)

# Phone pop-ups (web push): npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

DEFAULT_TZ=Asia/Karachi
