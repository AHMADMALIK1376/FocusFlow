# API: no address needed. The app calls /api on its own address; the dev server
# (package.json "proxy") and Vercel (vercel.json) pass it on to the backend.
# Setting REACT_APP_API_URL would send calls straight to another address, where
# the sign-in cookie is not kept.

# App Configuration
REACT_APP_VERSION=2.0.0
REACT_APP_NAME=FocusFlow

# Feature Flags (optional)
REACT_APP_ENABLE_EMAIL_QUEUE=true
REACT_APP_ENABLE_ATTENDANCE_WARNINGS=true